{
    "name": "oficina-mecanica/faturamento",
    "description": "Oficina Mecânica — serviço de Faturamento (catálogo, estoque, orçamento e pagamento pelo Mercado Pago)",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage",
        "coverage": "vendor/bin/phpunit --coverage-clover coverage.xml && php bin/check-coverage.php coverage.xml 80",
        "analyse": "vendor/bin/phpstan analyse",
        "lint": "vendor/bin/php-cs-fixer fix"
    }
}
